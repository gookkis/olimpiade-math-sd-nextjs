# SUMOPOD_API_KEY: API Key for SumoPod AI platform (for GLM models)
SUMOPOD_API_KEY="MY_SUMOPOD_API_KEY"

# SUMOPOD_BASE_URL: Base URL for SumoPod OpenAI-compatible endpoint (default: https://ai.sumopod.com/v1)
SUMOPOD_BASE_URL="https://ai.sumopod.com/v1"

# SUMOPOD_MODEL: GLM model name to use on SumoPod (e.g. glm-4, glm-4-flash, glm-4-air)
SUMOPOD_MODEL="glm-4"

# GEMINI_API_KEY: Fallback Gemini API key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
